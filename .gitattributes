* text=auto
*.cs text diff=csharp eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.meta text eol=lf
# Fin de linea estable entre Windows y Linux (Unity y los scripts de shell requieren LF)
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.inputactions text eol=lf
ProjectSettings/** text eol=lf
Packages/** text eol=lf
